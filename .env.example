# Copy this file to .env and fill in the values. .env is git-ignored.
# Never paste these keys into a chat. Set a monthly spending cap on each one.

# https://console.anthropic.com  (recall + judge LLMs)
ANTHROPIC_API_KEY=

# https://aistudio.google.com/apikey  (Gemini video judge)
GEMINI_API_KEY=

# https://www.assemblyai.com/dashboard  (transcripts with word timestamps + speakers)
ASSEMBLYAI_API_KEY=

# Telegram: create a bot with @BotFather, then message it once and run `make telegram-id`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional overrides
# FFMPEG_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
# FFPROBE_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe
# DATA_DIR=data
# RECALL_MODEL=claude-haiku-5-5
# JUDGE_MODEL=claude-sonnet-5-5
# GEMINI_MODEL=gemini-2.5-flash
